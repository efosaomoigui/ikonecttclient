# Dedicated PostgreSQL database. Never reuse a production database for tests.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgresql://ikonectt:CHANGE_ME@127.0.0.1:5432/ikonectt?schema=public
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:4175
SESSION_HOURS=8
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
PAYMENT_ADAPTER=manual
COVERAGE_ADAPTER=native
PROVISIONING_ADAPTER=manual
LEGACY_ADAPTER=disabled
EMAIL_ADAPTER=disabled
SMS_ADAPTER=disabled
SIMULATOR_SCENARIO=success
# One-time seed: set SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD in the environment.
