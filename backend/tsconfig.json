{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "node",
    "strict": true, "esModuleInterop": true, "experimentalDecorators": true,
    "emitDecoratorMetadata": true, "skipLibCheck": true, "outDir": "dist",
    "rootDir": "..", "sourceMap": true, "declaration": true
  },
  "include": ["src/**/*.ts", "../contracts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
