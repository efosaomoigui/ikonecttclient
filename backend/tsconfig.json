{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": true,
    "allowJs": true
  },
  "include": [
    "src/**/*.ts",
    "../contracts/**/*.ts",
    "../server/client-catalogue.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
