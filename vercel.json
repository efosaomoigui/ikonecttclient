{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist-public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/option-e/",
      "permanent": false
    },
    {
      "source": "/option-e",
      "destination": "/option-e/",
      "permanent": false
    },
    {
      "source": "/option-([a-d])",
      "destination": "/option-e/",
      "permanent": false
    },
    {
      "source": "/option-([a-d])/(.*)",
      "destination": "/option-e/",
      "permanent": false
    },
    {
      "source": "/residential(.html)?",
      "destination": "/option-e/#/residential",
      "permanent": false
    },
    {
      "source": "/business(.html)?",
      "destination": "/option-e/#/business",
      "permanent": false
    },
    {
      "source": "/coverage(.html)?",
      "destination": "/option-e/#/coverage",
      "permanent": false
    }
  ]
}
