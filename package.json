{
  "name": "ikonecttclient",
  "version": "1.0.0",
  "description": "Ikonectt public website and isolated presentation tooling",
  "main": "scripts/serve_public.cjs",
  "scripts": {
    "start": "node scripts/serve_public.cjs",
    "dev": "node scripts/serve_public.cjs",
    "build": "node scripts/build_public.cjs",
    "build:showcase": "node scripts/build_showcase.js",
    "dev:showcase": "node server.js",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "build:presentation": "node scripts/build_presentation.cjs",
    "build:public-demo": "node scripts/build_public.cjs --with-demos",
    "predev": "npm run build:public-demo"
  },
  "keywords": [
    "telecom",
    "fiber",
    "broadband",
    "nigeria",
    "ikonectt"
  ],
